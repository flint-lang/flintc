use "../../utils.ft"

test "0301":
	str path = "tests/regression/0301-0350";
	str file = "0301.ft";
	test_file_fail($"{path}/{file}", "Parse Error at tests/regression/0301-0350/0301.ft:27:23\n└──┬┤E0000│\n22 │ object Entity:\n27 │ »   Entity(d1, Data2, Data2);\n┌──┴───────────────────────┘\n└─ Object constructor contains data type 'Data2' twice\n");

