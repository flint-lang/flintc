use Core.print

enum MyEnum:
	VAL1, VAL2, VAL3, VAL4;

def main():
	MyEnum me = MyEnum.VAL1;
	switch me:
		VAL1: print("is val1\n");
		VAL2: print("is val2\n");
		VAL3: print("is val3\n");
		VAL4: print("is val4\n");

	me = MyEnum.VAL3;
	switch me:
		VAL1:
			print("is val1\n");
		VAL2:
			print("is val2\n");
		VAL3:
			print("is val3\n");
		VAL4:
			print("is val4\n");
