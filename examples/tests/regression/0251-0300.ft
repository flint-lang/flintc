use "../../utils.ft"

test "0251":
	str path = "tests/regression/0251-0300/0251";
	str file = "main.ft";
	test_file_ok_in(path, file, "md.(x, y, speed, is_something) = (1, 2, 3, false)\nmd2.(x, y, speed, is_something) = (3, 7, 1.5, true)\nbd.(x, y, z, dx, dy, dz, speed) = (1, 2, 3, 1, 2, 3, -5)\nbd2.(x, y, z, dx, dy, dz, speed) = (3, 5, 7, 2, 6, 12, -8)\n");

test "0252":
	str path = "tests/regression/0251-0300";
	str file = "0252.ft";
	test_file_ok($"{path}/{file}", "LINE_0:	use Core.print\nLINE_1:	use Core.filesystem as fs\nLINE_2:	\nLINE_3:	def main():\nLINE_4:		if not fs.file_exists(\"tests/regression/0251-0300/0252.ft\"):\nLINE_5:			print(\"File 'tests/regression/0251-0300/0252.ft' does not exst!\\n\");\nLINE_6:			return;\nLINE_7:		str[] lines = fs.read_lines(\"tests/regression/0251-0300/0252.ft\");\nLINE_8:		for u64 i = 0; i < lines.length; i++:\nLINE_9:			print($\"LINE_{i}:\\t{lines[i]}\\n\");\nLINE_10:		fs.write_file(\"/tmp/logfile\", \"wolololololasdjkf\\nsdfsafd\\n\\tsdf\\n\");\nLINE_11:		print(\"Written file 'logfile'\\n\");\nWritten file 'logfile'\n");

