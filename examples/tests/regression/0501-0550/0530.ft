use Core.print

data Data1:
	i32 x;
	i32 y;

data Data2:
	i32 z;
	i32 w;

data Data3:
	f32[] arr;
	f32? b;

object Object:
	data:
		Data1 d1,
		Data2 d2,
		Data3 d3;
	
	def print():
		print($"(x, y, z, w, arr.len, b.has_value) = ({d1.x}, {d1.y}, {d2.z}, {d2.w}, {d3.arr.len}, {d3.b != none})\n");

def main():
	d1 := Data1{};
	d2 := Data2{30};
	o := Object{
		.d1 = d1,
		.d2 = d2,
		};
	o.print();

	f32x4 v4 = f32x4{.x = 0, .z = 3};
	print($"v4 = {v4}\n");

	f64x3 v3 = f64x3{3, 5};
	print($"v3 = {v3}\n");

	data<i32, f32, str> t1 = data<i32, f32, str>{.$0 = 10, .$1 = 2.3, .$2 = "hi"};
	print($"t1.($0, $1, $2) = {t1.($0, $1, $2)}\n");

	data<f64, f32, u64> t2 = data<f64, f32, u64>{ 3.1412629, 2.313, 1_234_321 };
	print($"t2.($0, $1, $2) = {t2.($0, $1, $2)}\n");
