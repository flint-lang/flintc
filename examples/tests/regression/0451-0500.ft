use "../../utils.ft"

test "0451":
	str path = "tests/regression/0451-0500";
	str file = "0451.ft";
	test_file_ok($"{path}/{file}", "All tests passed\n");

test "0452":
	str path = "tests/regression/0451-0500/0452";
	str file = "main.ft";
	test_file_ok_in(path, file, "v3.(x, y, z) = (10, 20, 30)\nHello World!\nadd(10 + 20) = 30\n20 - 10 = 10\nsub(20, 10) = 10\n");

