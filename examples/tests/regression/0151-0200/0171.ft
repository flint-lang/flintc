use Core.print

interface IMovement:
	def move();
	def move_by(i32x2 diff);


data DPlayer:
	i32x2 pos;
	i32x2 dir;
	DPlayer(pos, dir);

func FPlayer requires(DPlayer d):
	def move():
		print($"Player moved from {d.pos} to ");
		d.pos += d.dir;
		print($"{d.pos}\n");

	def move_by(i32x2 diff):
		print($"Player moved by {diff} from {d.pos} to ");
		d.pos += diff;
		print($"{d.pos}\n");

object Player implements(IMovement):
	data: DPlayer;
	func: FPlayer;
	Player(DPlayer);


data DComputer:
	i32x2 pos;
	i32x2 dir;
	i32 speed;
	DComputer(pos, dir, speed);

func FComputer requires(DComputer d):
	def move():
		print($"Computer moved from {d.pos} to ");
		d.pos += d.dir * d.speed;
		print($"{d.pos}\n");

	def move_by(i32x2 diff):
		print($"Computer moved by {diff} from {d.pos} to ");
		d.pos += diff;
		print($"{d.pos}\n");

object Computer implements(IMovement):
	data: DComputer;
	func: FComputer;
	Computer(DComputer);


def apply_movement(mut IMovement m):
	m.move();
	m.move_by(i32x2(3, 3));

def main():
	p := Player(DPlayer(i32x2(10, 20), i32x2(3, 2)));
	IMovement m = p;
	apply_movement(m);

	if true:
		c := Computer(DComputer(i32x2(20, 10), i32x2(-3, -2), 2));
		m = c;
	apply_movement(m);
