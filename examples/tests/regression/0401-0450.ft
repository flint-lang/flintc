use "../../utils.ft"

test "0401":
	str path = "tests/regression/0401-0450";
	str file = "0401.ft";
	test_file_ok($"{path}/{file}", "elem is 0\nelem is 2\nelem is 4\nelem is 6\nelem is 8\nIteration 0\nIteration 1\nIteration 2\nIteration 3\nIteration 4\n");

test "0402":
	str path = "tests/regression/0401-0450/0402";
	str file = "main.ft";
	test_file_fail_in(path, file, "Parse Error at main.ft:6:11\n└─┬┤E0000│\n5 │ def main():\n6 │ »   v1 := c.Vec3(f32[3](0.0), 1);\n┌─┴───────────┘\n└─ Expected 1 argument for initializer but got 2\n");

test "0403":
	str path = "tests/regression/0401-0450";
	str file = "0403.ft";
	test_file_ok($"{path}/{file}", "Player moved from (10, 20) to (13, 22)\nComputer moved from (20, 10) to (14, 6)\n");

