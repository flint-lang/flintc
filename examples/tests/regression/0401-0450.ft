	test_file_ok($"{path}/{file}", "LINE_0:	use Core.print\nLINE_1:	use Core.filesystem as fs\nLINE_2:	\nLINE_3:	def main():\nLINE_4:		if not fs.file_exists(\"tests/regression/0401-0450/0414.ft\"):\nLINE_5:			print(\"File 'tests/regression/0401-0450/0414.ft' does not exst!\\n\");\nLINE_6:			return;\nLINE_7:		str[] lines = fs.read_lines(\"tests/regression/0401-0450/0414.ft\");\nLINE_8:		for u64 i = 0; i < lines.length; i++:\nLINE_9:			print($\"LINE_\{i}:\\t\{lines[i]}\\n\");\n");

