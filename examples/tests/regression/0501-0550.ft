test "0531":
	str path = "tests/regression/0501-0550";
	str file = "0531.ft";
	test_file_fail($"{path}/{file}", "Parse Error at tests/regression/0501-0550/0531.ft:4:31\n└─┬┤E0000│\n3 │ def main():\n4 │ »   f32x3 v3 = f32x3{1, 2, 3, 4, 5};\n┌─┴───────────────────────────────┘\n└─ Expected atmost '3' values for initializer, but more were provided\n");

test "0532":
