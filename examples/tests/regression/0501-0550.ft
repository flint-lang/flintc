test "0510":
	str path = "tests/regression/0501-0550";
	str file = "0510.ft";
	test_file_fail($"{path}/{file}", "Parse Error at tests/regression/0501-0550/0510.ft:4:5\n└─┬┤E0000│\n3 │ def main():\n4 │ »   print(\"Hello, World!\\n\");\n┌─┴─────┘\n├─ Call of undefined function 'print(str)'\n├─ Possible functions you could mean:\n│   ├─ p.print(u8) from Core.print\n│   ├─ p.print(i8) from Core.print\n│   ├─ p.print(u16) from Core.print\n│   ├─ p.print(i16) from Core.print\n│   ├─ p.print(u32) from Core.print\n│   ├─ p.print(i32) from Core.print\n│   ├─ p.print(u64) from Core.print\n│   ├─ p.print(i64) from Core.print\n│   ├─ p.print(f32) from Core.print\n│   ├─ p.print(f64) from Core.print\n│   ├─ p.print(str) from Core.print\n│   ├─ p.print(type.flint.str.lit) from Core.print\n│   └─ p.print(bool) from Core.print\n└─ You need to cast the argument to one of the supported types\n");

