use "../../utils.ft"

test "0051":
	str path = "tests/regression/0051-0100";
	str file = "0051.ft";
	test_file_fail($"{path}/{file}", "Parse Error at tests/regression/0051-0100/0051.ft:3:9\n└─┬┤E0000│\n1 │ def main():\n3 │ »   i32 x = 8;\n┌─┴─────────┘\n└─ Variable 'x' already exists\n");

