use "../../utils.ft"

test "0151":
	str path = "tests/regression/0151-0200/0151";
	str file = "main.ft";
	test_file_ok_in(path, file, "is VAL1\nis VAL2\nis VAL3\nis VAL4\nis VAL5\n");

test "0152":
	str path = "tests/regression/0151-0200";
	str file = "0152.ft";
	test_file_fail($"{path}/{file}", "Parse Error at tests/regression/0151-0200/0152.ft:3:10\n└─┬┤E0000│\n3 │ use Core.something\n┌─┴──────────┘\n├─ The Core module 'something' does not exist\n└─ Available Core modules are\n    ├─ assert\n    ├─ env\n    ├─ filesystem\n    ├─ math\n    ├─ parse\n    ├─ print\n    ├─ read\n    ├─ system\n    └─ time\n");

