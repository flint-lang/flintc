use "../../utils.ft"

test "0201":
	str path = "tests/regression/0201-0250";
	str file = "0201.ft";
	test_file_ok($"{path}/{file}", "ix2 = (1, 2)\nfx3 = (2.2, 3.3, 4.4)\n");

