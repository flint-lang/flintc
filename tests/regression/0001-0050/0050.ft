use Core.print

data BaseData:
	i32 speed;

func BaseFunc requires(BaseData d):
	def base():
		print($"speed = {d.speed}\n");

object BaseEntity:
	data: BaseData;
	func: BaseFunc;

data MyData:
	i32 x;
	i32 y;
	i32 z;

func MyFunc requires(MyData d):
	def print():
		print($"d = ({d.x}, {d.y}, {d.z})\n");
	
	def get_x() -> i32:
		return d.x;

object MyEntity:
	data:
		BaseData, MyData;
	func:
		BaseFunc, MyFunc;

def main():
	d := MyData{10, 20, 30};
	MyFunc.print(d);
	x := MyFunc.get_x(d);
	print($"d.x = {x}\n");

	BaseEntity be = BaseEntity{BaseData{10}};
	// be.base();

	// MyEntity e = MyEntity(d);
	// e.print();
	// x = e.get_x();
	// print($"e.get_x() = {x}\n");
