use Core.print

def pow(i32 x) -> i32:
	return x ** 2;

def add(i32 x, i32 y) -> i32:
	if y > 20:
		return y;
	else if y > 10:
		return x;
	return pow(x);

def main():
	i32 r1 = @add(10, 20) + 30;
	print($"r1 = {r1}\n");

	i32 r2 = @add(10, 30) + 30;
	print($"r2 = {r2}\n");

	i32 r3 = @add(10, 3);
	print($"r3 = {r3}\n");
