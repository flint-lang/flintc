use Core.print

variant Cell:
	Empty(void),
	Input(u32),
	Operator(str);

def helper(u32 n) -> str:
	return $"N{n}";

def one(Cell c) -> str:
	return switch c:
		Cell.Empty() -> "E";
		Cell.Input(input) -> $"I{helper(input)}";
		Cell.Operator(op) -> $"O({op})";

def main():
	print(one(Cell.Input(7)));
	print("\n");
