use Core.print

data Node[type T]:
	T value;
	Node[T]? next = none;

func FList[type T] requires(Node[T] list):
	def append(T value):
		if list.next != none:
			FList.append[T](list.next!, value);
		else:
			list.next = Node[T]{value};

	const def print():
		print(str(list.value));
		if list.next != none:
			print(" -> ");
			FList.print[T](list.next!);
		else:
			print("\n");

object List[type T]:
	data: Node[T];
	func: FList[T];

def main():
	l := List[i32]{};
	l.append(10);
	l.append(20);
	l.append(30);
	l.print();
