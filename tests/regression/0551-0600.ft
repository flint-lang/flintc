test "0556":
	const bool is_windows = not file_exists("/tmp");
	str path = "regression/0551-0600";
	str file = "0556.ft";
	if is_windows:
		test_test_ok(path, file, "regression\\0551-0600\\0556.ft:\n ├─ t1     \x1b[32m✓ passed\x1b[0m\n └─ t2     \x1b[32m✓ passed\x1b[0m\n\n\x1b[32m✓ All tests passed!\x1b[0m\n");
	else:
		test_test_ok(path, file, "regression/0551-0600/0556.ft:\n ├─ t1     \x1b[32m✓ passed\x1b[0m\n └─ t2     \x1b[32m✓ passed\x1b[0m\n\n\x1b[32m✓ All tests passed!\x1b[0m\n");

