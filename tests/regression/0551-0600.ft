test "0563":
	str path = "regression/0551-0600";
	str file = "0563.ft";
	test_test_ok(path, file, "--help", 1, "Usage: test [TEST]*\n\nAvailable TESTs:\n  t1    Execute test t1, skipped by default\n  t2    Execute test t2, skipped by default\n");

test "0564":
	str path = "regression/0551-0600";
	str file = "0564.ft";
	test_test_ok(path, file, "bogus", 1, "Unrecognized argument: bogus\nUsage: test [TEST]*\n\nAvailable TESTs:\n  t1    Execute test t1, skipped by default\n  t2    Execute test t2, skipped by default\n");

test "0565":
	const bool is_windows = not file_exists("/tmp");
	str path = "regression/0551-0600";
	str file = "0565.ft";
	if is_windows:
		test_test_ok(path, file, "", 1, "regression\\0551-0600\\0565.ft:\n ├─ test1 \x1b[32m✓ passed\x1b[0m\n ├─ test2 \x1b[31m✗ failed\x1b[0m\n │   ├─ Output ────────────────┐\n │   │ State.(id, ok) = (2, 1) │\n │   └─────────────────────────┘\n └─ test3 \x1b[31m✗ failed (pre)\x1b[0m\n     ├─ Output ─┐\n     └──────────┘\n\n\x1b[31m✗ 2 tests failed!\x1b[0m\n");
	else:
		test_test_ok(path, file, "", 1, "regression/0551-0600/0565.ft:\n ├─ test1 \x1b[32m✓ passed\x1b[0m\n ├─ test2 \x1b[31m✗ failed\x1b[0m\n │   ├─ Output ────────────────┐\n │   │ State.(id, ok) = (2, 1) │\n │   └─────────────────────────┘\n └─ test3 \x1b[31m✗ failed (pre)\x1b[0m\n     ├─ Output ─┐\n     └──────────┘\n\n\x1b[31m✗ 2 tests failed!\x1b[0m\n");

