test "0574":
	str path = "regression/0551-0600";
	str file = "0574.ft";
	test_file_fail($"{path}/{file}", "Parse Error at regression/0551-0600/0574.ft:3:9\n└─┬┤E0000│\n3 │ def add(int x, int y) -> int:\n┌─┴─────────┘\n├─ Parameters of runtime function cannot be of compile-time only type 'int'\n└─ If you want a function to operate on compile-time types, you need to define the function as compile-time only using '@def'\n");

test "0575":
	str path = "regression/0551-0600";
	str file = "0575.ft";
	test_file_fail($"{path}/{file}", "Parse Error at regression/0551-0600/0575.ft:3:22\n└─┬┤E0000│\n3 │ def add[type T](T x, int y) -> T:\n┌─┴──────────────────────┘\n├─ Parameters of runtime function cannot be of compile-time only type 'int'\n└─ If you want a function to operate on compile-time types, you need to define the function as compile-time only using '@def'\n");

