	str path = "regression/0551-0600";
	str file = "0557.ft";
	test_test_ok(path, file, "There are no tests to run\n");

test "0558":
	str path = "regression/0551-0600";
	str file = "0558.ft";
	test_test_fail(path, file, "Parse Error at regression/0551-0600/0558.ft:4:1\n└─┬┤E0000│\n4 │ def main(str[] args):\n┌─┴─┘\n├─ The '#test_entry' annotation is not allowed on 'main' function\n└─ The 'main' function is skipped in '--test' mode\n");

test "0559":
	str path = "regression/0551-0600";
	str file = "0559.ft";
	test_test_fail(path, file, "Parse Error at regression/0551-0600/0559.ft:4:1\n└─┬┤E0000│\n4 │ def entry():\n┌─┴─┘\n├─ Invalid definition of the '#test_entry' function\n└─ The '#test_entry' function has to take one 'str[]' parameter and can only return 'i32' or nothing (void)\n");

test "0560":
	const bool is_windows = not file_exists("/tmp");
	str path = "regression/0551-0600";
	str file = "0560.ft";
	if is_windows:
		test_test_fail(path, file, "Parse Error at regression/0551-0600/0560.ft:8:1\n└─┬┤E0000│\n8 │ def entry2(str[] args):\n┌─┴─┘\n├─ The '#test_entry' function is already defined in this program\n├─ First defined at regression\\0551-0600\\0560.ft:4:1\n└─ Only one '#test_entry' function is allowed in the entire codebase\n");
	else:
		test_test_fail(path, file, "Parse Error at regression/0551-0600/0560.ft:8:1\n└─┬┤E0000│\n8 │ def entry2(str[] args):\n┌─┴─┘\n├─ The '#test_entry' function is already defined in this program\n├─ First defined at regression/0551-0600/0560.ft:4:1\n└─ Only one '#test_entry' function is allowed in the entire codebase\n");

