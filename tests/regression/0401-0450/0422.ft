use Core.print

data Data:
	i32 x;
	i32 y;

interface Interface:
	def print();

func Func requires(Data d):
	def print():
		print($"d.(x, y) = {d.(x, y)}\n");

object E1 implements(Interface):
	data: Data;
	func: Func;

object E2 implements(Interface):
	data: Data;
	func: Func;

object E3 implements(Interface):
	data: Data;
	func: Func;

def main():
	print("Hello, World!\n");
