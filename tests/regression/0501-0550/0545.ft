use Core.array
use Core.print

def print_arr(i32[] arr):
	for (i, e) in arr:
		print($"arr[{i}] = {e}\n");

def main():
	i32[] arr = i32[_]{1, 3, 4};
	print("Test insert: prepend\n");
	insert[i32](arr, 0, 0);
	print_arr(arr);
	print("\nTest insert: middle\n");
	insert[i32](arr, 2, 2);
	print_arr(arr);
	print("\nTest insert: append\n");
	insert[i32](arr, 5, arr.len);
	print_arr(arr);

	print("\nTest resize: grow to 9\n");
	resize[i32](arr, 9);
	print_arr(arr);
	print("\nTest resize: shrink to 2\n");
	resize[i32](arr, 2);
	print($"arr.len = {arr.len}\n");
	print("\nTest resize: grow to 5 with 100s\n");
	resize[i32](arr, 5, 100);
	print_arr(arr);

	print("\nTest shrink: by 2\n");
	shrink[i32](arr, 2);
	print_arr(arr);
	print("\nTest shrink: by 0\n");
	shrink[i32](arr, 0);
	print_arr(arr);

	print("\nTest remove: at 1\n");
	i32? removed = remove[i32](arr, 1);
	print($"removed! = {removed!}\n");
	print_arr(arr);
	print("\nTest remove: at 4\n");
	removed = remove[i32](arr, 4);
	print($"removed.has_value = {removed != none}\n");
	print_arr(arr);

	print("\nTest merge: with i32[3](1) at end\n");
	i32[] src = i32[3](1);
	merge[i32](arr, src, arr.len);
	print($"src.len = {src.len}\n");
	print_arr(arr);
	print("\nTest merge: with i32[_]{1, 2, 3} at 0\n");
	src = i32[_]{1, 2, 3};
	merge[i32](arr, src, 0);
	print($"src.len = {src.len}\n");
	print_arr(arr);
	print("\nTest merge: with i32[_]{20, 30} at 2\n");
	src = i32[_]{20, 30};
	merge[i32](arr, src, 2);
	print($"src.len = {src.len}\n");
	print_arr(arr);
