use "../../utils.ft"

test "0_cpl_data.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "0_cpl_data.ft";
	test_file_ok($"{path}/{file}", "n.next!.value = 20\n");

test "1_cpl_specialization.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "1_cpl_specialization.ft";
	test_file_ok($"{path}/{file}", "n1.next!.value = 20\nn2.next!.value = 72.339996\n");

test "2_cpl_specialization_flattened.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "2_cpl_specialization_flattened.ft";
	test_file_ok($"{path}/{file}", "n1.next!.value = 20\nn2.next!.value = 72.339996\n");

test "3_generic_fn_add.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "3_generic_fn_add.ft";
	test_file_ok($"{path}/{file}", "res1 = 30\nres2 = 7.64\nres3 = Hello, there!\n");

test "4_generic_fn_bogus_ok.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "4_generic_fn_bogus_ok.ft";
	test_file_ok($"{path}/{file}", "Hello, World!\n");

test "5_generic_fn_bogus_err.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "5_generic_fn_bogus_err.ft";
	test_file_fail($"{path}/{file}", "Parse Error at wiki/intermediates_guide/comptime/5_generic_fn_bogus_err.ft:4:16\n└─┬┤E0000│\n3 │ def foo[type T](T x) -> T:\n4 │ »   ahahsdl := alsdfba(T);\n┌─┴────────────────┘\n└─ Call of undefined function 'alsdfba(i32)'\n\nParse Error at wiki/intermediates_guide/comptime/5_generic_fn_bogus_err.ft:8:15\n└─┬┤E0000│\n6 │ def main():\n8 │ »   i32 res = foo[i32](10);\n┌─┴───────────────┘\n├─ Call of undefined function 'foo(int)'\n└─ Possible functions you could mean:\n    └─ foo[type T](const T x) from file '5_generic_fn_bogus_err.ft'");

test "6_generic_fn_inferrence.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "6_generic_fn_inferrence.ft";
	test_file_ok($"{path}/{file}", "[1, 2, 3, 4, 5, 6]\n");

test "7_generic_variant.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "7_generic_variant.ft";
	test_file_ok($"{path}/{file}", "maybe!(Option[i32].Ok) = 100\nmaybe == Option[i32].None = true\n");

test "8_generic_func.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "8_generic_func.ft";
	test_file_ok($"{path}/{file}", "v2.(x, y) = (10, 20)\nv2.(x, y) = (15, 25)\nv2.(x, y) = (5, 5)\n");

test "9_generic_object.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "9_generic_object.ft";
	test_file_ok($"{path}/{file}", "l1.size() = 3\n10 -> 20 -> 30\nl2.size() = 3\n3.14 -> 6.9 -> 42.0\n");

test "10_generic_interface.ft":
	str path = "wiki/intermediates_guide/comptime";
	str file = "10_generic_interface.ft";
	test_file_ok($"{path}/{file}", "o.compare_with(10)  = false\no.compare_with(100) = true\n");
