use "utils.ft"

use "examples/aoc/2025/test.ft"

use Core.filesystem

#test_performance
test "perf":
	str path = "examples/perf";
	str file = "main.ft";
	test_compiles_in(path, file, none);

#test_performance
test "fsh":
	str path = "examples/fsh";
	str file = "main.ft";
	test_compiles_in(path, file, none);

#test_performance
test "pong":
	str path = "examples/pong";
	str file = "main.ft";
	test_compiles_in(path, file, none);

#test_performance
test "pong-2.0":
	const bool is_windows = not file_exists("/tmp");
	if is_windows:
		// Raylib does not work on Windows yet
		return;
	str path = "examples/pong-2.0";
	str file = "main.ft";
	Config.compile_v_static = false;
	test_compiles_in(path, file, "--flags=\"-lraylib\"");
	Config.compile_v_static = DefaultConfig.COMPILE_V_STATIC;

